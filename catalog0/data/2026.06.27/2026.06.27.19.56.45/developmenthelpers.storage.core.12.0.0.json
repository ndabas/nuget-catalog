  "licenseUrl": "https://aka.ms/deprecateLicenseUrl",
  "listed": true,
  "packageHash": "L2JiLte/50cTeOjj2Tsxa+GiolwBcAGCVAvyfj7ZtYtIA62A74gio/7tuXG/BEh0Ra/HO72Y6jetWbayPHFx7w==",
