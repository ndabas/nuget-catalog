  "description": "Twilio messaging client: SMS, MMS and WhatsApp, single and bulk send, delivery status polling. Credentials and default senders are supplied by the host application.",
  "iconFile": "brain_enterprise_logo_48x48.png",
  "id": "BrainEnterprise.Api.Twilio",
