  "description": "Parses a file, arg, or stdin using a built-in or generated parser.\nThis program is part of the Trash toolkit.",
  "id": "trparse",
  "isPrerelease": false,
  "lastEdited": "2026-01-25T16:38:27.18Z",
  "listed": true,
  "packageHash": "ieJHL1gsoApvRO0g0ueF260AGkC+1+EjoLvSFDXKmhmlJDBOgmtm2/On7rVR/V/6kTc0INzAzAKkY85qCq7tFQ==",
  "packageHashAlgorithm": "SHA512",
