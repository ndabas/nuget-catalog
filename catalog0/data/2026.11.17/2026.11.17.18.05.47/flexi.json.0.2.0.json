  "packageHash": "FK4fnBJALR/syaZZs6QKYliy/C6eatmhrVXtSUdMIL8Jbz/H93SDyKxqqHXxBWQH40Ore25ULmnFXB7JcKGkzw==",
  "packageHashAlgorithm": "SHA512",
