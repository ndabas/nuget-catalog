  "projectUrl": "https://github.com/MarkCBB/MongoDB-ASP.NET-Session-State-Store/wiki",
  "published": "2018-02-25T15:54:05.99Z",
  "releaseNotes": "This release implements performance improvements. The test cases implemented in the project TestApplicationv2_0 are able to create 21.024 sessions using this release instead of 17.024 sessions using the previous one. Both performance tests did run during the same time and environment.",
  "requireLicenseAcceptance": false,
  "summary": "MongoDB Session State Provider. This implementation allows server failure without interruptions in a Replica Set environment.",
  "title": "MongoDB Session State Store Provider",
