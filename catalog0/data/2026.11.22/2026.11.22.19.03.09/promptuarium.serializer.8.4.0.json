  "packageHash": "CRVn9hZfG9wyAH2vjt6ff+f0npD2SSYHjvZGFh8ZaUpjaK9dWqSApe6Sbze8YmTZzrzQ5WK6sFLSbtxEHqBnxg==",
  "packageHashAlgorithm": "SHA512",
