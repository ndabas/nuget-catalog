  "description": "A lightweight .NET library for bounded, observable, self-cleaning async execution with signal-based coordination. Fire... and Don't Quite Forget.",
  "iconFile": "icon.png",
  "id": "mostlylucid.ephemeral",
  "isPrerelease": true,
