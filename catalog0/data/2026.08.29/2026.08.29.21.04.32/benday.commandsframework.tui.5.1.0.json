  "description": "An in-process terminal UI for any tool built on Benday.CommandsFramework. Reference this package and call .WithTui() and the tool gains a 'tui' keyword that browses its commands, fills in a form and runs it without leaving the terminal.",
  "iconFile": "bdc_mark_128_128.png",
  "id": "Benday.CommandsFramework.Tui",
  "isPrerelease": false,
  "lastEdited": "2026-08-29T21:04:32.473Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "btOJYDx1sbRgcNK8B0LOsZa7JTUUv3wM659JNUJ3FOn7/O0x+2Mutivm/rhckz6tTdFftLL5rvyOqHosTR7O0Q==",
