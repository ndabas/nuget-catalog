  "description": "Model-Update-Observable (reactive MVU) bindings for Avalonia. Views run once and bind control properties directly to the model stream, for C# and F#.",
  "id": "MVUish.Avalonia",
  "isPrerelease": false,
  "lastEdited": "2026-10-17T03:38:35.973Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
