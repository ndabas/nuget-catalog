    "message": "The Microsoft Bot Framework SDK has been deprecated and replaced by the Microsoft 365 Agents SDK.  Migration guidance can be found here: https://learn.microsoft.com/en-us/microsoft-365/agents-sdk/bf-migration-guidance",
    "reasons": [
      "Legacy"
    ]
