  "description": "Collects device sensor data (GPS, BLE iBeacons, barometer, compass), sends it to the infsoft location calculation service and returns calculated indoor and outdoor user positions.",
  "id": "Infsoft.LocationDetection",
  "isPrerelease": false,
  "lastEdited": "2026-10-28T07:32:32.067Z",
