  "description": "wpf曲线框架。可以自定义曲线属性\n      交互式悬停 多曲线支持  颜色标识 封装良好\n      Random rand = new Random();\n      double[] yValues = Enumerable.Range(0, 107)\n      .Select(_ => rand.NextDouble() * 100)\n      .ToArray();\n      double[] yValues1 = Enumerable.Range(0, 107)\n      .Select(_ => rand.NextDouble() * 900)\n      .ToArray();\n\n      string[] dayLabels = Enumerable.Range(1, 107)\n      .Select(i => $\"A{i}天\")\n      .ToArray();\n      CurveControlBuilder.Create()\n      .WithAxis(\"日期\", \"温度 (°C)\")\n      .WithYRange(0, 1000, 50)\n      .WithXLabelsFromDates(dayLabels)\n      .AddCurve(\"曲线1\", yValues1, Brushes.Red)\n      .AddCurve(\"曲线2\", yValues2, Brushes.Blue)\n      .RenderTo(mainGrid);//mainGrid是对应Grid的名称 可以自定义",
