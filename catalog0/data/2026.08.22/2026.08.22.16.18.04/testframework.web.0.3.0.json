  "packageHash": "X5fbNBzbsk7qy7AzRgVYP1JAu1BwS6U6ObWtaTz2miZSdZqeXglpwXt2GsKNTEZvSwC1TOSpt49mZHocGYOFeg==",
  "packageHashAlgorithm": "SHA512",
