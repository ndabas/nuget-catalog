  "created": "2026-07-26T18:56:54.293Z",
  "description": "Blazor wrapper for the Swiper touch slider, built on the framework-agnostic Swiper Element web component. Ships the Swiper bundle and auto-registers it - no npm or manual script tags.",
  "iconFile": "icon.png",
  "id": "Kebechet.Blazor.Swiper",
  "isPrerelease": false,
  "lastEdited": "2026-07-26T18:59:59.047Z",
