  "description": "A .NET library providing XDG-like base-directory resolution for application config, data, cache, and state directories in a cross-platform way.",
  "id": "FVNever.AppDirs",
  "isPrerelease": false,
  "lastEdited": "2026-08-08T21:50:59.447Z",
