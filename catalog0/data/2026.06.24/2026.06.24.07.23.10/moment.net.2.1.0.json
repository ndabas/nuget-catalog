  "description": "A library aimed at adding in some relevant functionality as seen in moment.js that is missing in the System.DateTime construct",
  "iconFile": "logo.png",
  "id": "moment.net",
  "isPrerelease": false,
  "lastEdited": "2026-06-24T07:22:39.703Z",
