  "listed": true,
  "packageHash": "KGo/Ut90MbdEto3oDlabq8KxycTCiIfed9ya9j+PbPcAxAv4UF6fDYyj1BwNH3hu4oPOXyj1CY8j3G2ZnhllWA==",
  "packageHashAlgorithm": "SHA512",
  "packageSize": 207002,
  "projectUrl": "https://github.com/AdamTovatt/easy-reasy",
  "published": "2026-11-02T04:33:45.017Z",
  "readmeFile": "README.md",
  "releaseNotes": "Adds EasyReasyAuthOptions.CookieTokenPaths, off by default, so a browser can open a protected file in a new tab with its own session instead of a public link. On a listed path, a GET or HEAD request, never a WebSocket handshake, may carry its token in a path-scoped, HttpOnly, SameSite=Strict cookie, after the header and the query string. The built-in login, refresh and logout endpoints set and clear the cookie, and new HttpContext helpers do the same for your own endpoints. See https://github.com/AdamTovatt/easy-reasy/blob/auth-v5.13.0/EasyReasy.Auth/README.md#migration-from-5120",
