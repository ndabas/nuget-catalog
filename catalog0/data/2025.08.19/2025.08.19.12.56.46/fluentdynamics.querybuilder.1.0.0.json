  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2025.08.19.12.56.46/fluentdynamics.querybuilder.1.0.0.json#deprecation",
    "message": "Handle null values in Where method parameters\n\nUpdated the `Where` method in `LinkEntityBuilder.cs` and `QueryExpressionBuilder.cs` to check for `null` values in the `value` parameter. If `value` is `null`, the method now calls `AddCondition` without the `value` argument. If not, it adds the condition with the specified `value`. Additionally, the `value` parameter in `QueryExpressionBuilder.cs` has been given a default value of `default` for improved flexibility.",
    "reasons": [
      "CriticalBugs"
    ]
  },
