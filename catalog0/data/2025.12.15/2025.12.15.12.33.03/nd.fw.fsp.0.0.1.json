  "description": "A unified, provider-agnostic file storage abstraction library supporting Azure Blob Storage and AWS S3. Simplifies cloud storage operations with a consistent API across multiple cloud providers.",
  "id": "ND.FW.FSP",
  "isPrerelease": false,
  "lastEdited": "2025-12-15T12:32:57.9Z",
  "listed": true,
  "packageHash": "qHrp/X+crBqmuWqT9yrmzesMyTAyrrPqOaGcIe/HvG9ypuGZiZYKndHDtmBFJAGbMDV7WldqNsxEaSC3hn8iJA==",
