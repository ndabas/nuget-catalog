  "description": "Bundle: installs the complete in-process LinKit stack (CQRS, endpoints, background jobs, data access, outbox/inbox, sagas, caching, resilience, tenancy and JSON) with one PackageReference. Contains no code of its own. Broker clients are intentionally not included.",
  "id": "LinKit.Engine.Monolith",
  "isPrerelease": false,
  "lastEdited": "2026-11-21T06:55:32.603Z",
