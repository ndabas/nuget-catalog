    "@id": "https://api.nuget.org/v3/catalog0/data/2026.09.30.03.32.16/herocrypt.1.0.1.json#deprecation",
    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.09.30.03.32.16/herocrypt.1.0.1.json#deprecation/alternatePackage",
      "id": "HeroCrypt",
      "range": "[1.0.2, )"
    },
    "message": "Security update: 1.0.1 and earlier expose MPC/PSI simulations without distributed privacy or authenticated Beaver triples. 1.0.0 and earlier also have forgeable threshold signatures; 0.3.0 and earlier have the secp256k1 signing flaw. Upgrade to 1.0.2. MPC and threshold operations are disabled; review prior uses and independently revalidate results. Migration: https://github.com/KoalaFacts/HeroCrypt/blob/main/docs/migration-guide.md",
    "reasons": [
      "CriticalBugs"
    ]
  },
  "description": "A comprehensive, RFC-compliant cryptographic library for .NET featuring Argon2 (RFC 9106), Blake2b (RFC 7693), ChaCha20-Poly1305 (RFC 8439), Curve25519 (RFC 7748), BIP32/BIP39 HD wallets, post-quantum cryptography (ML-KEM, ML-DSA, SLH-DSA), and modern AEAD ciphers. Multi-framework support: .NET Standard 2.0, .NET 8.0/9.0/10.0.",
  "id": "HeroCrypt",
