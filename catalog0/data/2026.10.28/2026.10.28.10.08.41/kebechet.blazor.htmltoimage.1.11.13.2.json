  "description": "Blazor wrapper for html-to-image: capture any DOM element as PNG, JPEG, SVG, raw bytes or pixel data. Ships the library and auto-registers it - no npm, no CDN, no manual script tags.",
  "iconFile": "icon.png",
  "id": "Kebechet.Blazor.HtmlToImage",
  "isPrerelease": false,
  "lastEdited": "2026-10-28T10:08:15.32Z",
