    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.06.25.20.29.01/devwinui.controls.9.3.0.json#deprecation/alternatePackage",
      "id": "DevWinUI",
      "range": "*"
    },
    "message": "This package has been deprecated as part of the DevWinUI v10.0.0 package restructuring.\n\nStarting with v10.0.0:\n\nDevWinUI now contains the controls library.\nDevWinUI.Base contains the core functionality previously provided by DevWinUI.\n\nPlease update your package references accordingly:\n\nReplace DevWinUI.Controls with DevWinUI.\nReplace DevWinUI (pre-v10) with DevWinUI.Base if you only need the core library.\n\nThank you for using DevWinUI.",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "Experience WinUI 3 quickly and easily with the help of DevWinUI.Controls, Everything you need to develop an application is gathered in one place. DevWinUI.Controls Includes custom controls, styles, landingPages,Compositions and win2d.",
