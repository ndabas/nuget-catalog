    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2025.01.17.11.45.13/httpclientserviceex.1.9.0.json#deprecation/alternatePackage",
      "id": "SmartHttpClient",
      "range": "[1.0.3, )"
    },
    "message": "The HttpClientService package is now deprecated and is no longer maintained. We strongly recommend migrating to the new SmartHttpClient package (version 1.0.0), which offers enhanced features, improved performance, and better support for modern HTTP client use cases.\n\nSmartHttpClient simplifies HTTP interactions by automatically handling JSON serialization/deserialization, managing authentication, and providing a clean, reusable API. It's designed to save developers time and effort while ensuring best practices.\n\nTo migrate, update your project references with the SmartHttpClient package:\ndotnet add package SmartHttpClient --version 1.0.0\n",
    "reasons": [
      "Other"
    ]
  },
  "description": "HTTP Client Service Library for .NET 8.0. This is a utility that abstracts the functionality of HttpClient, providing a reusable, configurable, and extendable way to interact with external APIs or HTTP services.",
