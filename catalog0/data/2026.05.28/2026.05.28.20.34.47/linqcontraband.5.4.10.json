  "description": "Stop smuggling bad queries into production. LinqContraband is a Roslyn Analyzer that catches EF Core performance killers (client-side evaluation, N+1 queries) at compile time.",
  "developmentDependency": true,
  "iconFile": "icon.png",
  "id": "LinqContraband",
