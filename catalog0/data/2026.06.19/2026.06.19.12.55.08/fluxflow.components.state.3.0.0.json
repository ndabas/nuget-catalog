  "description": "A standalone keyed state-reducer node for FluxFlow: a reducer input in, an updated state snapshot broadcast out, per-key state kept in the node. No engine required.",
  "id": "FluxFlow.Components.State",
  "isPrerelease": false,
  "lastEdited": "2026-06-19T12:54:45.573Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
