  "description": "ONNX Runtime native bundle with Aardvark-style embedded natives: DirectML on Windows, CoreML on macOS, CPU + system-CUDA discovery on Linux. Pairs with Microsoft.ML.OnnxRuntime.Managed.",
  "id": "Unofficial.OnnxRuntime",
  "isPrerelease": false,
