  "description": "Windows, Linux X11 and macOS window hosts with GPU-preferred rendering and diagnosed CPU fallback. macOS currently uses managed CPU rendering and the official MIT Avalonia window bridge.",
  "id": "SimdSkia.Avalonia.Desktop",
  "isPrerelease": false,
  "lastEdited": "2026-11-07T10:17:38.057Z",
