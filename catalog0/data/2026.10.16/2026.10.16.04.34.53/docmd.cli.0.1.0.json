  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.10.16.04.34.53/docmd.cli.0.1.0.json#deprecation",
    "message": "These versions embed PhoenixmlDb.Xslt 2.7.0 or earlier, which GHSA-5697-c8qg-472f (high) names. A stylesheet passed with --stylesheet is evaluated in part while it compiles, and that evaluator could read this process's environment: a licence key, or a token a build gave the process, could be written into the converted Markdown. No resource policy prevented it.\n\ndocmd 0.3.0 pins the patched engine (2.9.0) and bounds a caller's stylesheet as well: every transform runs under a regular-expression time limit and a resource policy. Upgrade to 0.3.0 or later.\n\nConversion output changes in 0.3.0, deliberately: a paragraph indented with tabs is no longer turned into a code block, and an interrupted numbered list keeps its numbering.",
    "reasons": [
      "CriticalBugs"
    ]
  },
  "description": "Converts Microsoft Word documents to Markdown for AI/RAG indexing and human reading.",
