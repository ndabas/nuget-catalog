  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.10.23.09.21.32/jorgecostamacia.shared.http.minimalapi.validation.1.0.0.json#deprecation",
    "message": "This package is deprecated and will not receive further updates.\n\nThe endpoint filter pattern (`WithValidation<TRequest>()`) hides the fact that a request is validated behind the route registration, rather than at the point where the request is actually handled. We recommend instead calling `validator.ValidateAndThrow(request)` directly inside each Minimal API handler, resolving `IValidator<TRequest>` via `[FromServices]` — it keeps validation explicit and visible right where the request is processed, with less indirection for the developer to follow.\n\nExisting versions remain available for projects already depending on this package, but no new releases are planned.",
    "reasons": [
      "Legacy"
    ]
  },
