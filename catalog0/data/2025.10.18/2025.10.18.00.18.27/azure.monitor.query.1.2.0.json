    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2025.10.18.00.18.27/azure.monitor.query.1.2.0.json#deprecation/alternatePackage",
      "id": "Azure.Monitor.Query.Logs",
      "range": "*"
    },
    "message": "The Azure Monitor Query library for .NET has been modularized to provide more focused functionality. The operations for querying logs have been moved from the combined Azure.Monitor.Query package which also included querying metrics to a dedicated Azure.Monitor.Query.Logs package. This separation offers several advantages:\n\n- Smaller dependency footprint for applications that only need to query logs\n- More focused API design specific to logs query operations\n- Independent versioning allowing logs functionality to evolve separately\n- Clearer separation of concerns between logs and metrics operations",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "A library for querying Azure Monitor's Logs and Metrics data sources.",
