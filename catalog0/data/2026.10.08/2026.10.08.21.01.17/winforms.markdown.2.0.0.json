  "description": "A native, lightweight Markdown control for Windows Forms that renders Markdown directly with GDI+ without a web browser.",
  "id": "WinForms.Markdown",
  "isPrerelease": false,
  "lastEdited": "2026-10-08T21:00:42.55Z",
