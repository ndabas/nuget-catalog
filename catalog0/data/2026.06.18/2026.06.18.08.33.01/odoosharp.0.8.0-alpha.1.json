  "description": "Typed .NET client for Odoo's JSON-2 API with model mapping, strongly typed\n            domains, relation mapping, and create/write/unlink support.",
  "iconFile": "odoosharp-logo.png",
  "id": "OdooSharp",
  "isPrerelease": true,
  "lastEdited": "2026-06-18T08:32:44.31Z",
  "licenseExpression": "AGPL-3.0-or-later",
