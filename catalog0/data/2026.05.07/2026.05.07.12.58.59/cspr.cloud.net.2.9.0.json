  "description": "A .NET client library for interacting with the CSPR Cloud API, providing access to Casper blockchain data for both Mainnet and Testnet environments.",
  "id": "CSPR.Cloud.Net",
  "isPrerelease": false,
  "lastEdited": "2026-05-07T12:58:58.317Z",
