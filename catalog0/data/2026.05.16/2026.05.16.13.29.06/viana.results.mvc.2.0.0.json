  "description": "ASP.NET Core MVC integration for Viana.Results: an ActionResult and filter that serialize Result/Result<T>/ListResult<T>/PagedResult<T> with the correct HTTP status and RFC 9457 problem details on errors.",
  "id": "Viana.Results.Mvc",
  "isPrerelease": false,
  "lastEdited": "2026-05-16T13:28:52.577Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
