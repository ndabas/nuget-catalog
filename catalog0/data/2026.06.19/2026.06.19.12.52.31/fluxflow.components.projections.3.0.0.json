  "description": "A standalone event-projection node for FluxFlow: post ProjectionEvent values, fold matching events into rolling EventProjectionSnapshot counts/rate/latest, broadcast on output with error/event ports. No engine required.",
  "id": "FluxFlow.Components.Projections",
  "isPrerelease": false,
  "lastEdited": "2026-06-19T12:52:30.737Z",
