    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.08.28.13.17.27/aumerial.data.nti.4.3.0.json#deprecation/alternatePackage",
      "id": "Aumerial.Data.Nti",
      "range": "[5.0.0, )"
    },
    "message": "NTi 4 is now a legacy version and no longer receives new features.\n\nNTi 5 is a complete rewrite of the provider with the same public API and the same connection string keywords: applications running on NTi 4 upgrade to 5.0.0 without code changes. Version 5 brings a fully redeveloped and optimized transport layer, a truly asynchronous engine from OpenAsync to DisposeAsync, sovereign CCSID conversion tables with no external dependency, service program procedure calls, and connection pooling improvements.",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "Fully managed and standalone ADO.NET provider for IBM i, iSeries ans AS/400 servers.",
  "iconFile": "nti black mini.png",
