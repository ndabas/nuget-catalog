  "description": "A general serializer between .NET objects and Promptuarium trees in the PRMT:CFG1-LE layout: typed holders, byte[] as BLOB, no JSON in between; layering (Populate), records, attributes.",
  "id": "Promptuarium.Serializer",
  "isPrerelease": false,
  "lastEdited": "2026-11-22T19:02:50.92Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
