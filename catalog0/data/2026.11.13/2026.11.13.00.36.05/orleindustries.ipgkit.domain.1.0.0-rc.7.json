    "@id": "https://api.nuget.org/v3/catalog0/data/2026.11.13.00.36.05/orleindustries.ipgkit.domain.1.0.0-rc.7.json#deprecation",
    "message": "Security: upgrade to 1.0.0-rc.8. In 1.0.0-rc.7 and earlier, admin actions were authorized by the page they sit on rather than by the action, the configuration view opened every section to every reader, sessions outlived sign-out, and an API consumer could read, void or refund another consumer's payment by its id. 1.0.0-rc.8 fixes these, requires a fresh second factor for each sensitive action and a second person to approve Critical admin actions, refunds and voids, and brings breaking changes and database migrations; see the upgrade guide.",
    "reasons": [
      "Other",
      "Legacy",
      "CriticalBugs"
    ]
  },
