  "description": "OmniAssert runtime package for .NET tests. Provides fluent Verify-style assertions, expressive failure messages, object equivalence diffing, exception assertions, and AssertionScope for aggregated failures.",
  "iconFile": "omni-assert-logo.png",
  "id": "OmniAssert",
