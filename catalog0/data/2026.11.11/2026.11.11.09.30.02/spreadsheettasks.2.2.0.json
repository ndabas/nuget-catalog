  "description": "High-performance .NET library for reading and writing Excel files (.xlsx, .xlsb), with streaming APIs and NativeAOT validation.",
  "id": "SpreadSheetTasks",
  "isPrerelease": false,
  "lastEdited": "2026-11-11T09:29:45.17Z",
