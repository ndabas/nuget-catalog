  "packageHash": "BjNgPc8cpSS/q9zcRsUtFPoKkZeTrOEj61QYbXhW3Fb5HOqlHsFYojzQtOhNo3YsB9VNEXez212eB+NiN+/quQ==",
  "packageHashAlgorithm": "SHA512",
  "packageSize": 404455,
