  "description": "High performance, ultra-low-latency, allocation-free, feature rich and easy to use\n\t\t\twrap over System.Console",
  "id": "PrettyConsole",
  "isPrerelease": false,
  "lastEdited": "2025-11-15T13:41:00.4Z",
