  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.04.10.15.31.47/pitasoft.parse.6.0.2.json#deprecation",
    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.04.10.15.31.47/pitasoft.parse.6.0.2.json#deprecation/alternatePackage",
      "id": "Pitasoft.BinaryText",
      "range": "*"
    },
    "message": "Pitasoft.Parse is being discontinued and will no longer receive new features or evolutionary improvements. Its original scope has been divided into two independent packages to separate responsibilities and allow for clearer evolution of each area.\n\nFrom now on, the functionality is distributed as follows:\n\nPitasoft.BinaryText: focused on transformation between binary data and text representations, with an emphasis on scenarios such as hexadecimal and related conversions.\n\nPitasoft.ObjectMapping: focused on object mapping in the backend, especially in Entity -> DTO, DTO -> Entity flows, partial updates, fluid configuration, validation, and performance optimizations.\n\nThis separation improves the cohesion of each package, simplifies maintenance, and allows for the incorporation of new, specialized capabilities that didn't fit well within Pitasoft.Parse as a single package.",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "High-performance extension methods for object property copying and byte conversions. Supports \n\t\t\t.NET 8.0+, optimized with compiled delegates and Span.",
