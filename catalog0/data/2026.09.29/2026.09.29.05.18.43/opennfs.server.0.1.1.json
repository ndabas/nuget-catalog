  "packageHashAlgorithm": "SHA512",
  "packageSize": 1581429,
  "projectUrl": "https://github.com/jchristn/OpenNFS",
  "published": "2026-09-29T05:14:15.473Z",
  "readmeFile": "README.md",
  "releaseNotes": "v0.1.1: fixes WriteAllBytesAsync truncation, create-if-missing, short writes, COMMIT/verifier handling, and FSINFO-sized transfers; adds NFSv3 SETATTR (client API and server INfsAttributeMutation capability), ranged/stream reads, stream writes, rename, READDIRPLUS listings, mkdir -p, exists/set-length/set-times, opt-in portmapper discovery, persistent multiplexed TCP connections (no connection per RPC), verbatim path components, explicit CREATE/MKDIR modes, and page-aligned READ chunking for knfsd. See CHANGELOG.md.",
