      "@id": "https://api.nuget.org/v3/catalog0/data/2026.09.28.18.52.41/handyui.winforms.1.0.33.26253.json#deprecation/alternatePackage",
      "id": "HandyUI.SilkNet",
      "range": "*"
    },
    "message": "HandyUI.WinForms is no longer maintained. It is strictly legacy and is not compatible with modern versions of HandyUI.Core.\nI recommend switching over to HandyUI.SilkNet for cross-platform usage and better performance and QoL improvements.\n\nI repeat,\nHandyUI.WinForms will no longer receive feature updates, bugfixes, and will no longer be aligned with modern versions of HandyUI.Core.\nIf you use HandyUI.WinForms and your software breaks, thats NOT MY FAULT.\nI have warned you.\nIt's your choice.",
    "reasons": [
      "Legacy"
    ]
  },
