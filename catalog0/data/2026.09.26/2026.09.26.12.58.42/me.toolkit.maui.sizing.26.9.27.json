  "listed": true,
  "packageHash": "a8jgJU8Dzh/hew3A3E3Yy1sf/WnPk9O8zh6pjCbHzA96qGu1G5ojXz4gtQu4IqtGwVlK6lvkSdHdSO6kpJHWJw==",
  "packageHashAlgorithm": "SHA512",
