  "description": "Class library for reading and decoding GIF files - cross-platform, dependency-free. Reads GIF87a/GIF89a headers and dimensions, and decodes image data to RGBA8 pixels.",
  "id": "Universal.Common.Formats.Gif",
  "isPrerelease": false,
  "lastEdited": "2026-08-19T08:02:12.473Z",
  "licenseExpression": "CC0-1.0",
  "licenseUrl": "https://licenses.nuget.org/CC0-1.0",
