  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.10.09.17.49.26/orleindustries.ipgkit.web.pay.1.0.0-rc.6.json#deprecation",
    "message": "Security: upgrade to 1.0.0-rc.7. In 1.0.0-rc.6 and earlier, the create-payment endpoint accepted a consumer id and a payment-link id from the request body, so one API consumer could create a payment attributed to another consumer (who then received a validly signed payment.created webhook) or attach it to another consumer's payment link. Fixed in 1.0.0-rc.7, which also brings breaking contract changes and three database migrations; see the upgrade guide.",
    "reasons": [
      "Other",
      "Legacy",
      "CriticalBugs"
    ]
  },
  "description": "The IpgKit hosted card page — /pay/{token} and its result page, and nothing else. Reference this alone to put a themeable, PCI-scoped checkout page behind your own portal without taking the operator console or the kit's citizen-account pages with it. Registers no Identity stack of any kind. Consume via AddIpgKitPay / UseIpgKitPay.",
