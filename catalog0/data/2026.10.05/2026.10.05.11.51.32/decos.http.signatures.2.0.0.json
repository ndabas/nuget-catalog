  "description": "A .NET Standard 2.0 library for generating signatures on HTTP messages. Typically, the SignatureAuthorizationHandler is used with an HttpClient for signing outgoing requests.",
  "id": "Decos.Http.Signatures",
  "isPrerelease": false,
  "lastEdited": "2026-10-05T11:51:28.79Z",
