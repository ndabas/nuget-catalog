  "readmeFile": "readme.md",
  "releaseNotes": "V3.2.0: Added Automatic Two-Way Binding, and comprehensive support for complex route patterns with multiple parameters (e.g., /users/{userId}/posts/{postId}). Enhanced route parameter substitution with query string handling. Updated sample projects to demonstrate multi-parameter navigation patterns.",
  "repository": "",
  "title": "MVVM for Blazor using CommunityToolkit.Mvvm with Complex Route Support",
