  "description": "Parses a file, arg, or stdin using a built-in or generated parser.\nThis program is part of the Trash toolkit.",
  "id": "trparse",
  "isPrerelease": false,
  "lastEdited": "2026-02-21T08:33:01.97Z",
  "listed": true,
  "packageHash": "1+ER9GYUbFMvLwHxG9OGp1JaoMpPrye0oJ8pYwrAEXaw4+GFt6zi45afS23wNXVnglj616E5MrHwjQDuQE3KUg==",
  "packageHashAlgorithm": "SHA512",
