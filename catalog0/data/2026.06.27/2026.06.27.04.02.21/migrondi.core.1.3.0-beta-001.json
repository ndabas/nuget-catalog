  "description": "This is the core library for the Migrondi CLI, you can use this\n      library to run the same functionality of Migrondi as part of your source\n      code or to write an abstraction for different kind  of tools.",
  "id": "Migrondi.Core",
  "isPrerelease": true,
  "lastEdited": "2026-06-27T04:02:09.907Z",
  "licenseExpression": "MIT",
