  "releaseNotes": "var monitor = new AmqpQueueMonitor(rabbitMqSettings, () =>\n AmqpQueueMonitor.WithServiceQueues(controller.GetUnits()\n  .Where(x => x.Kind == ServiceUnitKind.Handler)\n  .Select(x => x.SubscriptionEndpoint))); \nvar queues = await monitor.GetQueuesAsync(new QueueQuery\n{\n SortBy = QueueSortField.Messages, // по умолчанию\n Descending = true,                // самые большие сверху (по умолчанию)\n NameContains = \"orders\",          // фильтр по имени, без учёта регистра\n MinMessages = 1,                  // только непустые\n Top = 20\n});",
