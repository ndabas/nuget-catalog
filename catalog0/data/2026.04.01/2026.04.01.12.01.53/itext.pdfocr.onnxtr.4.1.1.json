    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.04.01.12.01.53/itext.pdfocr.onnxtr.4.1.1.json#deprecation/alternatePackage",
      "id": "itext.pdfocr.onnx.cpu",
      "range": "*"
    },
    "message": "Since we now support more than simply docTR ONNX models, the pdf-ocr-onnxtr package has been renamed and split into pdf-ocr-onnx-abstract and pdfocr-onnx-cpu. This change also accommodates for GPU acceleration using the onnxruntime_gpu package: use itext.pdfocr.onnx.cpu to run models on CPU or itext.pdfocr.onnx.abstract and onnxruntime_gpu to run models on GPU.\n\nSee the breaking changes for details on the differences from previous releases of pdfOCR: https://kb.itextpdf.com/itext/breaking-changes-for-pdfocr-5-0-0.",
    "reasons": [
      "Other"
    ]
  },
  "description": "pdfOCR is an iText add-on to recognize and extract text in scanned documents and images. It can also convert them into fully ISO-compliant PDF or PDF/A-3u files that are accessible, searchable, and suitable for archiving",
