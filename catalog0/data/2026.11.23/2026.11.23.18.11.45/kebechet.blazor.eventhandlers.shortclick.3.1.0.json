  "listed": true,
  "packageHash": "zFKr5blbL6M9/LPW3qrE1jl03k18wMe+dXnRCwNEWY/Ic28sgVXUqUfxt8i5iDgogLQaWebnneAxBCs2QxHniQ==",
  "packageHashAlgorithm": "SHA512",
