  "description": "support modbus hex HJ212(2017) string\n\t\t\tHow to use it?\n\t\t\tFrom the \"Protocol.xml\"\n\t\t\t<?xml version=\"1.0\" encoding=\"utf-8\"?>\n\t\t\t<Protocols>\n\t\t\t\t<Protocol ProtocolType=\"ModbusRtu\" Address=\"1\" FactoryName=\"name1\">\n\t\t\t\t\t<Command Name=\"Read1\" FunCode=\"3\" FirstAddress=\"0\" Len=\"1\" DataType=\"short\" />\n\t\t\t\t\t<Command Name=\"Read2\" FunCode=\"3\" FirstAddress=\"2\" Len=\"2\" DataType=\"float\" />\n\t\t\t\t\t<Command Name=\"Read3\" FunCode=\"3\" FirstAddress=\"x04\" Len=\"1\" DataType=\"short\" />\n\t\t\t\t\t<Command Name=\"Read4\" FunCode=\"3\" FirstAddress=\"0x05\" Len=\"1\" DataType=\"short\" />\n\t\t\t\t</Protocol>\n\t\t\t\t<Protocol ProtocolType=\"Hex\" FactoryName=\"name2\">\n\t\t\t\t\t<Command Name=\"OpenRead\" CmdData=\"FF 54 0D\"/>\n\t\t\t\t\t<Command Name=\"CloseRead\" CmdData=\"FF 55 0D\"/>\n\t\t\t\t</Protocol>\n\t\t\t</Protocols>\n\n\t\t\tCPlib.Interface.ICommand command = CPlib.Domain.Protocol.Build(name1,Read1)\n\t\t\t\n\t\t\tFrom the code\n\t\t\tclass ProtocolClass : ProtocolModbus\n\t\t\t{\n\t\t\t\tpublic ProtocolClass() : base(\"\")\n\t\t\t\t{\n\t\t\t\t\tInitProtocol();\n\t\t\t\t}\n\n\t\t\t\tvoid InitProtocol()\n\t\t\t\t{\n\t\t\t\t\tXmlProtocol xmlProtocol = new XmlProtocol() { FactoryName = \"name1\", ProtocolType = ProtocolType.ModbusRtu };\n\n\t\t\t\t\tXmlCommand Read1 = new XmlCommand() { Name = \"Read1\", FunCode = \"3\", FirstAddress = \"0\", Len = 1, DataType = DataType.short };\n\t\t\t\t\tXmlCommand Read2 = new XmlCommand() { Name = \"Read2\", FunCode = \"3\", FirstAddress = \"2\", Len = 2, DataType = DataType.float };\n\t\t\t\t\tXmlCommand Read3 = new XmlCommand() { Name = \"Read3\", FunCode = \"3\", FirstAddress = \"x04\", Len = 1, DataType = DataType.short };\n\t\t\t\t\tXmlCommand Read4 = new XmlCommand() { Name = \"Read4\", FunCode = \"3\", FirstAddress = \"0x05\", Len = 1, DataType = DataType.short };\n\n\t\t\t\t\txmlProtocol.Commands.Add(Read1);\n\t\t\t\t\txmlProtocol.Commands.Add(Read2);\n\t\t\t\t\txmlProtocol.Commands.Add(Read3);\n\t\t\t\t\txmlProtocol.Commands.Add(Read4);\n\n\t\t\t\t\tInitXmlProtocol(xmlProtocol);\n\t\t\t\t\tSlaveAddress = 9;\n\t\t\t\t}\n\t\t\t}",
