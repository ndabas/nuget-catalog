  "description": "Declarative syntax for System.CommandLine via attributes for easy, fast, strongly-typed (no reflection) usage. Includes a source generator which automagically converts your classes to CLI commands and properties to CLI options or CLI arguments.",
  "iconFile": "icon.png",
  "id": "DotMake.CommandLine",
  "isPrerelease": false,
  "lastEdited": "2025-07-15T12:42:45.87Z",
  "licenseExpression": "MIT",
