  "readmeFile": "README.md",
  "releaseNotes": "v2.8.1 is a patch release. It decodes CSV quoting and escapes before generated record binding, header matching, null-value checks, and validation, and reduces allocations when decoding quoted, escaped, and segmented columns in the buffered PipeReader path. Full changelog: https://github.com/KoalaFacts/HeroParser/blob/main/CHANGELOG.md",
