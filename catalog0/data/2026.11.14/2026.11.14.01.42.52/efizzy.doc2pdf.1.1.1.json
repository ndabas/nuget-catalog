  "description": "High-performance, zero-dependency .NET library to convert Word (.docx, .doc), HTML, Markdown, RTF, ODT, LaTeX, XML, and plain text documents to high-fidelity PDF directly in-process via native Rust engine.",
  "id": "Efizzy.Doc2Pdf",
  "isPrerelease": false,
  "lastEdited": "2026-11-14T01:41:33.857Z",
