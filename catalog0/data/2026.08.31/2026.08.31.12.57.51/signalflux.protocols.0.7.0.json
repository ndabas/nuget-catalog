  "description": "SignalFlux.Protocol provides protocol adapters for Modbus, MAVLink, NMEA 0183, CAN bus (DBC), and ARINC 429, bridging Signal<T> and Measurement<T> with real-world protocol data.",
  "id": "SignalFlux.Protocols",
  "isPrerelease": false,
