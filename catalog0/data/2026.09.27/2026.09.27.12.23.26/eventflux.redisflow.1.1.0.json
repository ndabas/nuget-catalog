  "description": "Lightweight .NET library for event-driven applications, providing distributed event support and domain events with EventFlux and Redis.",
  "id": "EventFlux.RedisFlow",
  "isPrerelease": false,
  "lastEdited": "2026-09-27T12:23:20.15Z",
