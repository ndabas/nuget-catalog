  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.07.28.07.04.14/qrshard.core.1.3.5.json#deprecation",
    "message": "Security: these versions have a path traversal in the decode path (CWE-22). The file name inside a shard header was used unsanitized to build the output path, so a crafted image could write outside the working directory, or to an absolute path. The target is truncated before SHA-256 verification runs, so a set that later fails verification has already overwritten it. Decoding untrusted images is what this library is for, so it is reachable in ordinary use.\nAffected: every version before 1.3.9. Fixed in 1.3.9 - please upgrade.\nDecodeImages(paths) is affected because outputPath defaults to null. Workaround if you cannot upgrade yet: always pass outputPath explicitly - it is used exactly as given and is not influenced by the shard header.\nDetails: https://github.com/lfarrand/QrShard/releases/tag/v1.3.9",
    "reasons": [
      "CriticalBugs"
    ]
  },
  "description": "Codec library for QrShard: encode any file into dense QR-style images and decode captures (screenshots, photos, recordings) back into the original, bit-for-bit (SHA-256 verified). Public API: QrShardCodec.",
