  "description": "Standalone deterministic source nodes for FluxFlow: generated and sequence emitters built as FlowSource<T> over an injected TimeProvider, with broadcast output/error/event ports. No engine required.",
  "id": "FluxFlow.Components.Sources",
  "isPrerelease": false,
  "lastEdited": "2026-06-19T12:53:20.95Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
