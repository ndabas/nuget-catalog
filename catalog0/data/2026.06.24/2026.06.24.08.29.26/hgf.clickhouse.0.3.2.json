  "description": "ClickHouse job storage for Hangfire: JobStorage, connection, write-only transaction, monitoring API, a polling job queue, and background maintenance (expiration, counter aggregation) on the Octonica ClickHouse client. Requires ClickHouse 24.12+. Note: ClickHouse is an OLAP store — the queue is at-least-once and locks are best-effort unless the opt-in KeeperMap path is enabled; keep jobs idempotent.",
  "id": "HGF.ClickHouse",
  "isPrerelease": false,
  "lastEdited": "2026-06-24T08:29:02.49Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "TxR4DCeS4xqlDnMMFNBlPWoGGHJauTk+q02bOMJZey1nQv7l7ylB16koxnn1BMHCLAaeiHqXgUYNXNGRsX405w==",
  "packageHashAlgorithm": "SHA512",
