  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "W08piE9wAMGr1n4VBARXTd3vMW8fN1jo+aENDH24SakeWDj6pak4WXo9v0zA7vjrFbQCBK2duLSxLWGJVEcRow==",
