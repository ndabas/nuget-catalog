  "description": "A Blazor wrapper for apex-grid, a Lit-based web-component data grid. The core library is bundled and shipped inside the package (no script tag or CDN needed).",
  "id": "Blazor-ApexGrid",
  "isPrerelease": false,
  "lastEdited": "2026-11-14T04:55:30.82Z",
  "licenseFile": "LICENSE.md",
