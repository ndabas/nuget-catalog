  "packageHash": "tOcmu8FByvhq71+L0ln9Be94nl4DeeFqN5h2amXNyo1HO20kA8zPrmair3GOmZ2DIF0ZKwp6ZVetm5b2kLUfoQ==",
  "packageHashAlgorithm": "SHA512",
