  "description": "DivisionCompute is a source-to-source compiler and runtime that lets you write HLSL compute shaders directly in C#",
  "id": "NorthRoc.DivisionCompute",
  "isPrerelease": false,
  "lastEdited": "2026-11-10T19:08:22.763Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
