  "packageHashAlgorithm": "SHA512",
  "packageSize": 4116455,
  "projectUrl": "https://www.html-to-pdf.net/",
  "published": "2026-11-20T10:58:33.91Z",
  "readmeFile": "docs\\README.md",
  "releaseNotes": "Version 10.0: Multi-page TIFF output: ConvertToTiff and ConvertToTiffInFolder. Thumbnails (ConvertToThumbnails), JpegQuality and TiffCompression, one page to an image or bytes (ConvertPageToImage). PNG compression level 0 to 9 (PngCompressionLevel): lossless, smaller PNG files at the higher levels. Version 10 is part of the ExpertPdf 22.0 release: it requires a version 10 license key.",
  "requireLicenseAcceptance": false,
  "summary": "Convert PDF pages to images (PNG, JPEG, BMP, multi-page TIFF) in any .NET application.",
  "title": "ExpertPdf PDF to Image Converter for .NET",
  "verbatimVersion": "10.0.0",
