  "description": "A comprehensive collection of reusable utilities, helpers, and base classes for .NET applications. Provides Result pattern, Domain entities, Events, Authorization, API Versioning, Swagger configuration, Endpoint mapping, and more for building clean, maintainable applications.",
  "id": "Maydon.Utilities",
  "isPrerelease": false,
