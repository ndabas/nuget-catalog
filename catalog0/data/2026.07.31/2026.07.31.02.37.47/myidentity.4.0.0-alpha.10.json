  "packageHash": "hdw61rGsJtQgbjTRHkbG5NvB+Uebx3HFWRZISyp8WR/AIIZAQMgqFhYh5hQpvhz6G33jWqwknGypzUNZZ7HL/A==",
  "packageHashAlgorithm": "SHA512",
