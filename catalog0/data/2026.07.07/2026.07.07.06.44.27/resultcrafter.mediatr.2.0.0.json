  "description": "MediatR pipeline behaviors for ResultCrafter that automatically run FluentValidation for handlers returning Result; short-circuiting with structured Error.BadRequest field errors.",
  "iconFile": "ResultCrafterLogo.png",
  "id": "ResultCrafter.MediatR",
