  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "vb3NUPHTljHnz//uhAm9EcibSrZit/zzNx9O9AqZ5Y/D7dnQolpbVF9IYyURSmOGs8+Yk2ZnWB9AHUDpiKrqjg==",
