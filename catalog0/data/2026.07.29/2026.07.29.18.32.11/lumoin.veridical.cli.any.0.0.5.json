  "packageHash": "rBxsdzH4rCEpxRv4hKNKEdWPFulH29RaIQESMhNY1zItKQtbOTDn2tAMNKTgirXVMC8aJUjDct+tuk/zVMd+8A==",
  "packageHashAlgorithm": "SHA512",
