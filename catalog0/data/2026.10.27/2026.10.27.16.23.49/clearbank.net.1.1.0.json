  "description": "Unofficial .NET client for ClearBank integration, creating online payments via their API.\n        Bank payment handling automation in United Kingdom and EU.",
  "id": "ClearBank.Net",
  "isPrerelease": false,
  "lastEdited": "2026-10-27T16:23:32.667Z",
