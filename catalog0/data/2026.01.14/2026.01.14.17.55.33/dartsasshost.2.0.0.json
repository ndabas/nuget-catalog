  "description": ".NET wrapper around the Dart Sass with the ability to support a virtual file system.",
  "iconFile": "icon.png",
  "iconUrl": "https://raw.githubusercontent.com/Taritsyn/DartSassHost/main/images/DartSassHost_Logo_128x128.png",
