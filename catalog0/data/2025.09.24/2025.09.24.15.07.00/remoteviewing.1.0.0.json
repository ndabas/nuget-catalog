  "description": "RemoteViewing is a .NET-native VNC client and server library.\n\nIt supports Raw, Hextile, Copyrect, and Zlib encodings, and includes a Windows Forms control to make embedding VNC in your program extremely easy.",
  "id": "RemoteViewing",
  "isPrerelease": false,
  "lastEdited": "2025-09-24T15:06:55.963Z",
  "licenseFile": "LICENSE.txt",
  "licenseUrl": "https://aka.ms/deprecateLicenseUrl",
