  "description": "API Interaction for TEPS Utilities with generic deserialization, configurable error reporting, and improved DI configuration. Supports REST, GraphQL, gRPC, WebSocket, SignalR, and SSE protocols.",
  "id": "Davasorus.Utility.DotNet.Api",
  "isPrerelease": false,
  "lastEdited": "2026-07-24T11:26:03.88Z",
