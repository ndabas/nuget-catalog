  "description": "Library that abstractly wraps DbConnection and a few other types to reduce duplicate code when interacting with a DbConnection and executing queries.",
  "id": "Pustalorc.DbConnectionWrapper",
  "isPrerelease": true,
  "lastEdited": "2026-10-05T01:37:11.057Z",
