  "description": "Opinionated C# lint and format rules, enforced at build time: custom Roslyn analyzers, a shared .editorconfig, and ReSharper code cleanup settings.",
  "developmentDependency": true,
  "id": "Nitpick",
  "isPrerelease": false,
  "lastEdited": "2026-11-14T21:31:46.72Z",
