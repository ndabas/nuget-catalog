    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.04.21.15.39.00/djretailing.umbraco.dropdown.1.0.0.json#deprecation/alternatePackage",
      "id": "DJRetailing.Umbraco.Suite",
      "range": "*"
    },
    "message": "Migration: 'DJRetailing.Umbraco.Dropdown' to 'DJRetailing.Umbraco.Suite'\nDJRetailing.Umbraco.Dropdown is succeeded by DJRetailing.Umbraco.Suite. This consolidates all editors into one package with unified branding.\n\nMigration Steps:\n1. Switch NuGet Package dotnet add package DJRetailing.Umbraco.Suite\n\n2. Update Program.cs Replace .AddDJRDropdown() with: .AddDJRSuite();\n\n3. Update appsettings.json Change the key prefix from Dropdown to Suite:\n\nJSON\n\"DJRetailing\": {\n  \"Suite\": { \n\t\"LicenseKey\": \"YOUR_LICENSE_KEY\"\n  }\n}\nIncluded Components:\nDJR Dropdown (Successor to the original)\nDJR RadioButton List & DJR Checkbox List\n\nSupports C# Enums (e.g., MyProject.Models.Countries), text lists, and Umbraco prevalues.",
    "reasons": [
      "Legacy"
    ]
  },
