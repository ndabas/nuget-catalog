  "licenseUrl": "https://licenses.nuget.org/MPL-2.0",
  "listed": true,
  "packageHash": "WVFpTN6ljftPbzvpQxkEEukrHKnjNvXakY58kWkXF5WGj/H2L/jXdqZWSxfuwYsBosOuhauO52C278++9eHVrQ==",
  "packageHashAlgorithm": "SHA512",
