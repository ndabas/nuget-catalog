  "description": "Easy to use Remoting library for .NET Core and .NET Framework",
  "id": "CoreRemoting",
  "isPrerelease": false,
  "lastEdited": "2026-11-17T22:04:30.243Z",
  "listed": true,
  "packageHash": "SL9R0zeovR4J/fBOVVepCzifuCjj9iDvNbQQzvgyLlTe9dL8q/j3cYf4Gm4NYpBoV8XyiEyRkfu6j46DTKFsLA==",
