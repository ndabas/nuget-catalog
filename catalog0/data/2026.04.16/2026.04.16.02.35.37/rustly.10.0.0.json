  "description": "Rust-inspired Result<T, E>, Option<T>, and Unit types for C#. Replace exceptions with explicit, composable error handling. Zero-allocation value types for high-performance scenarios.",
  "id": "Rustly",
  "isPrerelease": false,
  "lastEdited": "2026-04-16T02:35:36.16Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
