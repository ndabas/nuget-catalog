  "listed": true,
  "packageHash": "CjlaOvz7sdThrxPRpOJaAeFa3b22ubrXijaDt/N0VVF19qZ/mO6xK/VKFjrMwti4iAgiKNAJ/G8L0u1Xy+ZNXw==",
