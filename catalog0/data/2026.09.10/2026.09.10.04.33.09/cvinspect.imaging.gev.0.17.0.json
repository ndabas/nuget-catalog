  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.09.10.04.33.09/cvinspect.imaging.gev.0.17.0.json#deprecation",
    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.09.10.04.33.09/cvinspect.imaging.gev.0.17.0.json#deprecation/alternatePackage",
      "id": "CvInspect.Imaging.Gev",
      "range": "[0.20.0, )"
    },
    "message": "Single grabs stop working after 65,535 transmitted frames. The GVSP block id wraps at 65535 on a\n16-bit device, and the stale-frame guard compares ids by size, so past the wrap every arriving frame\nis rejected as older than the last one emitted. Every single grab then times out until the camera is\nreopened.\n\nYou are affected if the application ever starts a continuous stream and also grabs single frames. A\nlive preview counts, including one left running on a screen nobody is watching - so an application\nwhose inspection path only ever grabs single frames can still be exposed. The counter belongs to the\nopen, not to the stream: stopping continuous acquisition does not reset it, and a preview at 15 fps\nreaches the wrap in about an hour. Fixed in 0.20.0, which compares block ids modularly.",
    "reasons": [
      "CriticalBugs"
    ]
  },
  "description": "GigE camera acquisition for the CvInspect toolkit - an ICam backend that speaks the protocol directly, with no vendor SDK and no proprietary DLLs. Serial-number binding with actionable discovery diagnostics, user-set load, exposure control across SFNC generations, and PFNC pixel conversion including Bayer demosaic with phase diagnostics. Field validation against production cameras is still in progress.",
  "id": "CvInspect.Imaging.Gev",
