  "description": "ND Observability Framework provides unified logging, tracing, and metrics \n      capabilities for .NET microservices using Serilog, OpenTelemetry, and \n      distributed tracing decorators. The framework simplifies instrumentation \n      by offering pluggable logger services, trace interceptors, correlation ID \n      propagation, and out-of-the-box exporters for Loki, PostgreSQL, and OTLP.",
  "id": "ND.Observability.Framework",
  "isPrerelease": false,
  "lastEdited": "2025-11-20T13:20:54.757Z",
  "listed": true,
  "packageHash": "Hpq0Gzn/udxacpCBdx1ep/jEMuDndJFcPZNyV9oeOdWbhS0qEZlquqzpT8rGvndlogutWv8GKwfoVbOVh2G/BA==",
  "packageHashAlgorithm": "SHA512",
