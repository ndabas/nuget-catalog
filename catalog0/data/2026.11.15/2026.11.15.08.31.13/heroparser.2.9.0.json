  "packageHashAlgorithm": "SHA512",
  "packageSize": 2103178,
  "published": "2026-11-15T08:28:16.717Z",
  "readmeFile": "README.md",
  "releaseNotes": "v2.9.0 adds the net11.0 target (built and tested with the .NET 11.0.100 GA SDK alongside net8.0, net9.0, and net10.0), fixes culture-dependent number/date formatting and validation across readers, writers, AI helpers, and source generators, unquotes CSV headers and values in schema inference, converters, DataReader, CLI, and WebAssembly, and fixes WASM writer flushing and CLI error messages. Changelog: https://github.com/KoalaFacts/HeroParser/blob/main/CHANGELOG.md",
