  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "X5pj6PoUCL4y5niCBUjyefcvxS3L59LgnPoTLaF2YDzbphVjFy+eLR3ZS1LLBawFsHu9rrB7BacI0rUp0dIzdA==",
