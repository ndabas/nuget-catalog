  "description": "A component preview and development tool for ASP.NET Core Razor components. Provides an interactive UI for developing, testing, and documenting reusable Razor components, inspired by Storybook.",
  "id": "Manifesto.RazorKit",
  "isPrerelease": false,
  "lastEdited": "2026-10-23T13:54:12.737Z",
