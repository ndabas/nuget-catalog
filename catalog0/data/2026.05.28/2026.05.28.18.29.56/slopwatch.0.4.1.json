  "description": "Core library for detecting LLM-generated \"sloppy\" code patterns in .NET projects. Use this library to build custom detection rules, IDE extensions, or integrate slopwatch into your own analysis pipelines.",
  "iconFile": "logo.png",
  "id": "Slopwatch",
