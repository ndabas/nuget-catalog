  "description": "A lightweight, cross-platform .NET library for generating random strings and numbers.\n      Supports 13 character categories including lowercase, uppercase, alphanumeric,\n      symbols, and custom sets. Suitable for passwords, tokens, OTPs, and unique identifiers.",
  "id": "RandomString4Net",
  "isPrerelease": false,
  "lastEdited": "2026-04-23T15:58:10.877Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
