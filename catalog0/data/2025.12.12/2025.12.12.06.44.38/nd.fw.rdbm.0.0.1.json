  "packageHashAlgorithm": "SHA512",
  "packageSize": 38313,
  "published": "2025-12-12T06:41:13.643Z",
  "releaseNotes": "Version 0.0.1:\n      - Initial release with PostgreSQL support\n      - Query and stored procedure execution\n      - Single and multiple RefCursor support\n      - Polly-based retry policies\n      - Comprehensive error handling with error catalog\n      - Integrated logging with ND.Observability.Framework\n      - Restricted mode for query validation\n      - INOUT parameter support",
  "repository": "",
