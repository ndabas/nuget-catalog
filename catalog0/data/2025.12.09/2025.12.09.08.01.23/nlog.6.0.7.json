  "packageHash": "NGPwkcjnlWKla9cTqW0qNKhv3C6eRMj8dCU5wDXAf9/ZWZXNHOoyNVJKNgydWUmh72wHgJbptvt0XWJEG4Txfg==",
  "packageHashAlgorithm": "SHA512",
