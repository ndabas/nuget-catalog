  "packageHash": "lLt0hTnIYQhrShFUTIosiHKkCV7qjn5kOyQj+ap8gZ5HtHMyUQVgqVLJSfVb0P31tikSK62IEH45szqevcWYiA==",
  "packageHashAlgorithm": "SHA512",
