  "description": "AutoPipe streamlines your workflow by letting you focus on business logic while it manages pipeline execution, parameter handling, and method orchestration. Build robust, flexible, and easily refactorable pipelines with minimal effort.",
  "iconFile": "pipelines-icon.png",
  "id": "AutoPipe",
