  "description": "Token budget management for .NET 10 LLM agent loops. Tracks conversation growth, masks stale tool output, summarizes older history when needed, and keeps requests within a configured limit.",
  "id": "TokenGuard.Core",
  "isPrerelease": false,
  "lastEdited": "2026-10-07T11:30:05.723Z",
  "licenseExpression": "MIT",
