  "description": "Cache recovery component for CoreSystem.Cache on .NET 8, .NET 9 and .NET 10 that restores tracked memory fallback entries to the primary cache provider after recovery.",
  "id": "CoreSystem.Cache.Rehydration",
  "isPrerelease": false,
  "lastEdited": "2026-10-25T20:58:41.797Z",
  "licenseFile": "LICENSE",
