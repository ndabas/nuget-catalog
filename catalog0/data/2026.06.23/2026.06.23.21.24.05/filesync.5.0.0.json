  "description": "Sync/back up local files to a directory or Azure Blob storage, driven by a .filesync config (JSON or YAML) or inline options. Commands: sync, clean, watch, init; with dry-run, confirmation prompts, glob filters, and a preloaded REPL.",
  "id": "FileSync",
  "isPrerelease": false,
  "lastEdited": "2026-06-23T21:24:02.55Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
