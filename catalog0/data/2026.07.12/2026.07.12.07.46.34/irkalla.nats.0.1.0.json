  "packageHashAlgorithm": "SHA512",
  "packageSize": 108263,
  "projectUrl": "https://github.com/Er3shk1gal/Irkalla.Nats/tree/main",
  "published": "2026-07-12T07:43:33.183Z",
  "readmeFile": "README.md",
  "releaseNotes": "0.1.0 — First release: attribute-based services ([NatsService]/[NatsMethod]), subject-token routing, JSON/Protobuf handlers, JetStream at-least-once delivery with redelivery backoff and DLQ (ErrorPolicy Skip/Dlq/Stop), native Core request-reply RPC (INatsRpcClient), typed producer (INatsProducer) + producer-only registration, consumer-side deduplication (Nats-Msg-Id + duplicate window), multi-assembly scanning, per-service consumer overrides, appsettings/IConfiguration binding + IOptions, consumer health check, net8.0/net10.0 multi-target, first-class auth/TLS options plus raw NATS.Net passthrough. NATS.Net 3.0.0.",
