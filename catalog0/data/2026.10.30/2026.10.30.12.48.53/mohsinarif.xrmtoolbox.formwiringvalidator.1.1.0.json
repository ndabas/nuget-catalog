  "readmeFile": "README.md",
  "releaseNotes": "Adds two checks: a handler whose function reads the execution context without it being passed, and a library that loads before the one it depends on.",
  "requireLicenseAcceptance": false,
  "summary": "Finds broken form script wiring in Dataverse environments.",
