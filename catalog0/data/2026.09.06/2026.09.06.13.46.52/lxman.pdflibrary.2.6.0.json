  "authors": "Michael Jordan",
  "catalog:commitId": "e90a21aa-73dd-45d5-80fd-2f9ae9c8b6fa",
  "catalog:commitTimeStamp": "2026-09-06T13:46:52.2494404Z",
  "created": "2026-09-06T13:43:45.19Z",
  "description": "A comprehensive .NET library for parsing, rendering, creating, editing, optimizing, and validating PDF documents. Pure C# implementation with no native or third-party codec dependencies; cross-platform on .NET 8, 9, and 10. Supports PDF 1.x and 2.0, and includes a read-only conformance preflight for PDF/A (2b/2u/3b), PDF/X-4, and PDF/UA-1.",
  "iconFile": "icon.png",
  "id": "Lxman.PdfLibrary",
  "isPrerelease": false,
  "lastEdited": "2026-09-06T13:46:22.453Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "MQNKnJ76WavImG5Djt5Dy+5fS+78t6HxohfamdOrSQi4yQ7gkiv/6msYTLeKfBOczezKead6V+CHvfPjKH4TgA==",
  "packageHashAlgorithm": "SHA512",
  "packageSize": 4730912,
  "projectUrl": "https://github.com/lxman/PdfLibrary",
  "published": "2026-09-06T13:43:45.19Z",
  "readmeFile": "README.md",
  "releaseNotes": "2.6.0 fixes four save-fidelity bugs (xref generation numbers, hex-string form, real-number precision, page-tree cycles), brings preflight to full veraPDF verdict parity on PDF/A-2b and 2u, and adds system font substitution (SystemFontLocator.Resolve/EnumerateFaces, ISystemFontProvider defaults), a document font inventory (FontInventory), CID-to-Unicode extraction with bundled Adobe CMaps, pdf:Trapped and Language metadata, and several editing entry points (SetFileId, SetAnnotationFlags, ConsolidateOutputIntents, ReplaceOutputIntentProfile, HasXfa). Additive and back-compatible: the public API is now a checked-in file. The XMP format layer lives in the bundled PdfLibrary.Xmp assembly with type forwarders (due for removal at 3.0.0). See CHANGELOG.md.",
