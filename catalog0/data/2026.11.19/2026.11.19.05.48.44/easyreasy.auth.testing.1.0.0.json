  "description": "A software WebAuthn authenticator for testing passkey and security-key endpoints built on EasyReasy.Auth against its real verifier. For test projects only: never reference it from production code",
  "iconFile": "BaseIcon.png",
  "id": "EasyReasy.Auth.Testing",
