  "description": "Enriches Serilog events with client IP, RequestBody, RequestQuery, HTTP request headers and memory usage. Correlation Id can be added via WithRequestHeader.",
  "iconFile": "icon.png",
  "id": "Serilog.Enrichers.HttpContext",
