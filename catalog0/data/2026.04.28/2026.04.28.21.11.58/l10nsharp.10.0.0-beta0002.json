  "description": "L10NSharp is a .NET localization library. It collects strings which need localization when your application first runs and saves them in a XLIFF file.",
  "id": "L10NSharp",
  "isPrerelease": true,
  "lastEdited": "2026-04-28T21:11:26.067Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
