  "listed": true,
  "packageHash": "KSRXcJimoPVLiFN7tmfpIFmD55JOuFxGuSzLUQstAgTY6h5S8hMk4XdM9vElgV/B8AgFDCeylLP8MAa8L+Aj3g==",
  "packageHashAlgorithm": "SHA512",
