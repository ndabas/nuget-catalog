  "description": "A unit-test-like system thats designed for production runtime application healthchecks. but can also be used for developers to unit test their app",
  "iconFile": "ForgeGuardLogo.jpg",
  "id": "WinterRose.ForgeGuard",
  "isPrerelease": false,
