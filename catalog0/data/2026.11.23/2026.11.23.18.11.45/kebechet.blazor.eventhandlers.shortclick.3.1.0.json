  "description": "Contains @onshortclick blazor event handler, and an opt-in click mode that gives @onclick the same short-click semantics",
  "id": "Kebechet.Blazor.EventHandlers.ShortClick",
  "isPrerelease": false,
  "lastEdited": "2026-11-23T18:11:42.993Z",
