  "packageHash": "HZFfXu4KpelajvtGVNpwlx6phF9YN0VcqcK0P7+qZsyeB9eON6FyVx9WpJjPesbtQVh6TWvXHhZ9KMNaxWYg+w==",
  "packageHashAlgorithm": "SHA512",
