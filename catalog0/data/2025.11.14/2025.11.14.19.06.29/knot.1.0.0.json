  "description": "A lightweight and efficient object-to-object mapping library for .NET Standard 2.0. Knot simplifies the mapping of properties between different types with minimal configuration. Features include type mapping, custom converters, mapping profiles, extension methods, and optimized performance through expression compilation.",
  "iconFile": "logo.png",
  "id": "Knot",
  "isPrerelease": false,
  "lastEdited": "2025-11-14T19:06:09.87Z",
