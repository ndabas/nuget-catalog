  "description": "# A class that includes methods for all major types of encryption/decryption, neatly organized for easy reuse. It includes:\n\n\n      AES (Symmetric)\n\n      RSA (Asymmetric)\n\n      Hashing (SHA256, SHA512, MD5)\n\n      Base64 (Encoding/Decoding)\n\n      DES (for legacy systems)\n\n      Use\n\n      // AES\n      string aesKey = \"mysupersecurekey123!\";\n      string encryptedAes = CryptoHelper.AESEncrypt(\"Hello World\", aesKey);\n      string decryptedAes = CryptoHelper.AESDecrypt(encryptedAes, aesKey);\n\n      // RSA\n      CryptoHelper.GenerateRSAKeys(out var pubKey, out var privKey);\n      string rsaEncrypted = CryptoHelper.RSAEncrypt(\"Secret Message\", pubKey);\n      string rsaDecrypted = CryptoHelper.RSADecrypt(rsaEncrypted, privKey);\n\n      // Hashing\n      string hash = CryptoHelper.SHA256Hash(\"password123\");\n\n      // Base64\n      string encoded = CryptoHelper.Base64Encode(\"Encode this\");\n      string decoded = CryptoHelper.Base64Decode(encoded);\n\n      // DES\n      string desEncrypted = CryptoHelper.DESEncrypt(\"Legacy\", \"12345678\");\n      string desDecrypted = CryptoHelper.DESDecrypt(desEncrypted, \"12345678\");",
  "id": "AKSCryptoHelper",
