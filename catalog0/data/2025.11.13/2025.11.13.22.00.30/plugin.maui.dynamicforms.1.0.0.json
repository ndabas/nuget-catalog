  "description": "A flexible .NET MAUI library for dynamic form generation based on metadata. Supports multiple field types, validation, multi-block forms, async validation, fluent API, and fully customizable styling.",
  "id": "Plugin.Maui.DynamicForms",
  "isPrerelease": false,
  "lastEdited": "2025-11-13T22:00:13.43Z",
