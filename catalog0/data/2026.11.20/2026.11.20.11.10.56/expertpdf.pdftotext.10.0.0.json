  "readmeFile": "docs\\README.md",
  "releaseNotes": "Version 10.0: Text of every page in one call (ConvertToTextPages), several search terms at once (SearchTexts), document information (GetDocumentInformation). The size and rotation of every page: DocumentInformation.Pages (PdfPageInfo: crop box and media box in points, rotation). Version 10 is part of the ExpertPdf 22.0 release: it requires a version 10 license key.",
  "requireLicenseAcceptance": false,
  "summary": "Extract text from PDF documents in any .NET application.",
  "title": "ExpertPdf PDF to Text Converter for .NET",
