  "description": "ND Observability Framework provides unified logging, tracing, and metrics\n\t\t\tcapabilities for .NET microservices using Serilog, OpenTelemetry, and\n\t\t\tdistributed tracing decorators. The framework simplifies instrumentation\n\t\t\tby offering pluggable logger services, trace interceptors, correlation ID\n\t\t\tpropagation, and out-of-the-box exporters for Loki, PostgreSQL, and OTLP.",
  "id": "ND.Framework.Observability.Dotnet6",
  "isPrerelease": false,
  "lastEdited": "2025-11-24T06:40:14.8Z",
  "listed": true,
  "packageHash": "Ok+mYbhF88TLa2XOUC5917N9ekXfmJOoRghidoEfjelGk6f+FOo39WsDMAf0R8wjQQmNpXfHpYIu2dg5fxXcvg==",
  "packageHashAlgorithm": "SHA512",
