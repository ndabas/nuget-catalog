  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.11.19.17.06.38/singulink.codeanalysis.0.5.0.json#deprecation",
    "message": "0.6.0 finds copies that 0.5.0 misses: in code that was not built with the analyzers, through `MemberwiseClone`, and through `RuntimeHelpers.GetObjectValue`. A library built with 0.5.0 is treated as unchecked by 0.6.0 and later, so update and rebuild.",
    "reasons": [
      "Other"
    ]
  },
  "description": "Attributes that mark types and members for the Singulink.CodeAnalysis analyzers, such as [NonCopyable] for structs that must not be copied, and the NonCopyable.Move helper. Brings the analyzers with it.",
