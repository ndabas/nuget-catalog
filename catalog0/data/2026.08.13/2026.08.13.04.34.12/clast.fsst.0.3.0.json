  "packageHash": "ZTWqlVjfjRAtcW1H2cy+29lkAwKuFuoUfs64W8kXWWuAeX+gE5xbGykZKy+sBjdNJrj9P6FO+PDNNg3b5wZPFw==",
  "packageHashAlgorithm": "SHA512",
