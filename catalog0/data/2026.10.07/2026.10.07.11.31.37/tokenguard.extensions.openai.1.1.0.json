  "description": "OpenAI integration for TokenGuard on .NET 10. Converts prepared TokenGuard messages to OpenAI chat messages and lets TokenGuard use OpenAI to summarize older history when context gets tight.",
  "id": "TokenGuard.Extensions.OpenAI",
  "isPrerelease": false,
  "lastEdited": "2026-10-07T11:31:34.357Z",
  "licenseExpression": "MIT",
