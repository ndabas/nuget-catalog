  "description": "FsToolkit.ErrorHandling is an extensive utility library based around the F# Result type, enabling consistent and powerful error handling.",
  "id": "FsToolkit.ErrorHandling",
  "isPrerelease": true,
  "lastEdited": "2026-10-12T12:33:35.387Z",
