  "description": "FluentValidation endpoint-filter integration for ResultCrafter ASP.NET Core. Adds WithValidation<T>() to validate Minimal API requests with their registered IValidator<T> and short-circuit with an RFC 9457 ProblemDetails 400.",
  "iconFile": "ResultCrafterLogo.png",
  "id": "ResultCrafter.AspNetCore.FluentValidation",
  "isPrerelease": false,
  "lastEdited": "2026-07-07T06:43:14.877Z",
