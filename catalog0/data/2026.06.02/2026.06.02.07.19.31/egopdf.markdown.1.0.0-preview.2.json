  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "fBG8pDoyVfxFYyam3F+gypWwOCrRg6/CX4r/Tub/82Zk++NRrFf6MsSDUoveX5s4CmrjyIZE+IOhPlKHB9nJhw==",
