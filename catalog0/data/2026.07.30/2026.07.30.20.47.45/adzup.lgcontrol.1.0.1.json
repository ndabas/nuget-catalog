  "packageHashAlgorithm": "SHA512",
  "packageSize": 37182,
  "projectUrl": "https://adzup.net/",
  "published": "2026-07-30T20:44:51.467Z",
  "releaseNotes": "MacAddressGetCommand (ft) and ModelNameGetCommand (fv) now decode the panel's hex-encoded ASCII payloads (\"3232534d33472d424a\" → \"22SM3G-BJ\"); verified against a real 22SM3G-BJ. Without this, LgPlatformVersions.FromModel received raw hex and resolved every model to Unknown. Plain payloads (fy serial, fz firmware) are unaffected.",
  "requireLicenseAcceptance": false,
