  "description": "LibTopoART.Compatibility provides simplified access to the neural networks of LibTopoART using common data types. In particular, the data type decimal is replaced by more widely supported types such as double.",
  "iconFile": "logo.png",
  "id": "LibTopoART.Compatibility",
  "isPrerelease": false,
  "lastEdited": "2026-05-31T17:42:32.013Z",
