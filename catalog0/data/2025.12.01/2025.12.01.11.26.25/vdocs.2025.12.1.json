  "readmeFile": "README.md",
  "releaseNotes": "🚀 Enhancements\n      - Added full Theme support (colors, fonts, fills, lines, effects, backgrounds)\n      - Added Document Built-In Styles with complete Word style hierarchy\n      - Added Document Default Styles for automatic base formatting\n      - Improved style resolution pipeline for paragraphs, runs, tables, and numbering\n      - Updated DOM mappings to support theme-driven font and color inheritance",
  "requireLicenseAcceptance": true,
