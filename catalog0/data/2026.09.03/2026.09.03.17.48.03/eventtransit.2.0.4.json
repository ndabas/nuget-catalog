  "description": "A high-performance .NET messaging library with support for multiple message brokers (RabbitMQ, Kafka, Azure Service Bus). Features broker-agnostic design, outbox/inbox patterns, delayed messages, and comprehensive messaging capabilities.",
  "id": "EventTransit",
  "isPrerelease": false,
