  "description": "Dependency-free, Fable-safe, position-aware untyped JSON document API (strict RFC 8259): a JsonValue union you can pattern match, Parse, ToString, source positions and AsInteger()-style accessors. Works under Fable (JS and Python) and Native AOT.",
  "id": "Flexi.Json",
  "isPrerelease": false,
  "lastEdited": "2026-10-26T19:34:40.213Z",
  "licenseExpression": "MIT",
  "licenseUrl": "https://licenses.nuget.org/MIT",
  "listed": true,
  "packageHash": "PzLmo6RnL9AUyWVLGPHYMw9rCXHmyarQlQRiFalwqGTn7nvCQbf37jVEchqUkcnMAeBz8erhb2YptSeyv45REw==",
