  "description": "A powerful, easy-to-use NuGet package for integrating Elasticsearch and Kibana logging with Serilog in .NET applications. Features include health checks, correlation ID tracking, structured logging helpers, ES8 support, cluster support, and more.",
  "id": "Nazeh.ElasticLogger",
  "isPrerelease": false,
