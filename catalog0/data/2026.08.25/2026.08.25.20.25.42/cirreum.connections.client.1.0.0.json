  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.08.25.20.25.42/cirreum.connections.client.1.0.0.json#deprecation",
    "message": "[!WARNING]\nThis package is deprecated and this repository is archived.\n\nThe runtime extension packages named below — Cirreum.Runtime.Connections.SignalR, Cirreum.Runtime.Connections.WebSockets, and Cirreum.Runtime.Connections — were never published and do not exist.\n\nThe caller side of a long-lived Cirreum connection ships today as Cirreum.RemoteConnections.SignalR and Cirreum.RemoteConnections.WebSockets, registered through Cirreum.Runtime.RemoteConnections.SignalR / .WebSockets.\n\nEverything below is retained as a historical record and does not describe a supported package.",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "Client-side abstractions for long-lived Cirreum connections. Defines IRealtimeClient and RealtimeClientBase with connection lifecycle management, automatic reconnection, and state tracking. Transport-agnostic; concrete implementations live in runtime extension packages.",
