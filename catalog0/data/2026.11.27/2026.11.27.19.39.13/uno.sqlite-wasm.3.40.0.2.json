    "@id": "https://api.nuget.org/v3/catalog0/data/2026.11.27.19.39.13/uno.sqlite-wasm.3.40.0.2.json#deprecation",
    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.11.27.19.39.13/uno.sqlite-wasm.3.40.0.2.json#deprecation/alternatePackage",
      "id": "SQLitePCLRaw.bundle_e_sqlite3",
      "range": "*"
    },
    "message": "Not needed anymore: SQLitePCLRaw now includes SQLite for WebAssembly.\nThese packages don't work on Uno Platform 7, or on Uno Platform 6.7 apps that use the Skia renderer (the default).\n\nTo switch:\n1. Remove Uno.sqlite-wasm and Uno.SQLitePCLRaw.provider.wasm, plus any SQLitePCLRaw.bundle_sqlite3, SQLitePCLRaw.provider.sqlite3 or SQLitePCLRaw.bundle_green references added for them.\n2. With sqlite-net-pcl 1.11+ or Microsoft.Data.Sqlite, nothing else is needed. Otherwise, add SQLitePCLRaw.bundle_e_sqlite3.",
    "reasons": [
      "Legacy"
    ]
  },
