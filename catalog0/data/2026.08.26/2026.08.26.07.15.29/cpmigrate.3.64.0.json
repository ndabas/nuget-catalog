  "packageHash": "Xivtj5RMiug+WpA/wAYB1XZul5NmH2jpwSDYTjNGjMdKa9tlz47idGbh9dqeuNvHOsL74/7Uy13N1zsOXwuXTQ==",
  "packageHashAlgorithm": "SHA512",
