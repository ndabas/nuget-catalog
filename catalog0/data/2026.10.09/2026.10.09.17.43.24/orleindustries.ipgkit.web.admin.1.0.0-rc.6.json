  "deprecation": {
    "@id": "https://api.nuget.org/v3/catalog0/data/2026.10.09.17.43.24/orleindustries.ipgkit.web.admin.1.0.0-rc.6.json#deprecation",
    "message": "Security: upgrade to 1.0.0-rc.7. In 1.0.0-rc.6 and earlier, POST /payments accepted apiConsumerId and paymentLinkId from the request body, so one API consumer could create a payment attributed to another consumer (who then received a validly signed payment.created webhook) or attach it to another consumer's payment link (P77). Fixed in 1.0.0-rc.7. rc.7 also carries breaking contract changes and three migrations - see the CHANGELOG and docs/upgrading-to-v1.md section 15.",
    "reasons": [
      "Other",
      "Legacy",
      "CriticalBugs"
    ]
  },
  "description": "The IpgKit operator console: transactions, refunds, payment links, payment methods, webhooks and subscriptions, catalog, reports, audit and configuration, plus the operator sign-in pages and the admin user seeder. The hosted card page and the citizen account pages are NOT here - they ship as OrleIndustries.IpgKit.Web.Pay and OrleIndustries.IpgKit.Web.Customer so a citizen-facing deployment does not carry the operator console. Consume via AddIpgKitAdmin / UseIpgKitAdmin.",
  "id": "OrleIndustries.IpgKit.Web.Admin",
