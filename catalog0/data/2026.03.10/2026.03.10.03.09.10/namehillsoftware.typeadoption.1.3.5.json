  "description": "Embrace delegation, composition over inheritance, and mix-in style coding in C# by adopting the implementations\n            of members in your class. TypeAdoption will automatically delegate any unimplemented members to the adopted member.",
  "id": "NameHillSoftware.TypeAdoption",
  "isPrerelease": false,
  "lastEdited": "2026-03-10T03:09:07.287Z",
