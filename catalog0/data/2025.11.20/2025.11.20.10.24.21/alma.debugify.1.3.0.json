  "created": "2025-11-20T10:21:24.947Z",
  "description": "A dotnet tool that allows you to quickly debug your own nuget packages",
  "iconFile": "icon\\debugify.png",
  "id": "alma.debugify",
  "isPrerelease": false,
  "lastEdited": "2025-11-20T10:24:01.98Z",
