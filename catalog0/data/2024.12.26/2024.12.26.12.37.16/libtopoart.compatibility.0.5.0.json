  "created": "2024-12-26T12:34:45.097Z",
  "description": "LibTopoART.Compatibility provides a simplified access to the neural networks of LibTopoART using common data types. In particular, the data type decimal is substituted by more widely supported types such as double.",
  "iconFile": "logo.png",
  "id": "LibTopoART.Compatibility",
  "isPrerelease": false,
  "lastEdited": "2024-12-26T12:36:49.507Z",
