  "description": "ShellInject simplifies .NET MAUI Shell navigation for MVVM apps. It automatically binds pages and popups to ViewModels by convention or explicit XAML mapping, registers routes by page type, resolves ViewModels through dependency injection, and delivers forward and reverse navigation data through lifecycle-aware ViewModel hooks.",
  "id": "ShellInject",
  "isPrerelease": false,
  "lastEdited": "2026-07-09T03:13:15.18Z",
