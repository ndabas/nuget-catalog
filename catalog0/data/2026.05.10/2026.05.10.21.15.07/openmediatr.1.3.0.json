  "description": "Lightweight, free, open-source in-process mediator for .NET. Supports requests, streaming requests, notifications, pipeline behaviors, pre/post-processors, exception handlers/actions, and pluggable notification sinks.",
  "iconFile": "icon.png",
  "id": "OpenMediatR",
  "isPrerelease": false,
