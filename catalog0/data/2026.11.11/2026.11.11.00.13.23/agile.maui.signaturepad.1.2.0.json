  "description": "MAUI component library providing SignaturePad with pressure-aware variable-width strokes, biometric capture and image export. Android, iOS, macOS Catalyst and Windows.",
  "iconFile": "agile.png",
  "id": "Agile.Maui.SignaturePad",
  "isPrerelease": false,
  "lastEdited": "2026-11-11T00:13:13.95Z",
