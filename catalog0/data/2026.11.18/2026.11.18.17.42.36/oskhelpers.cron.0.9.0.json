  "description": "Scheduling of actions from a crontab file (standard cron syntax, Cronos), with automatic reload of the file, validation report and events raised at every scheduled time.",
  "iconFile": "logo_128px.jpg",
  "id": "OSKHelpers.Cron",
  "isPrerelease": false,
  "lastEdited": "2026-11-18T17:41:54.727Z",
