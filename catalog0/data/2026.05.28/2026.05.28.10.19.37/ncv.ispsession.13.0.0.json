  "description": "Provides scalable session state and application state management using Redis, designed for distributed ASP.NET Core backends. Supports BFF, OpenID Connect, and high-performance scenarios without relying on in-memory session state.",
  "iconFile": "logo.png",
  "id": "NCV.ISPSession",
