    "alternatePackage": {
      "@id": "https://api.nuget.org/v3/catalog0/data/2026.03.17.09.58.50/pandatech.masstransit.sqliteoutbox.5.1.1.json#deprecation/alternatePackage",
      "id": "Pandatech.MassTransit.EfCoreOutbox",
      "range": "*"
    },
    "message": "This package is deprecated and will not receive further updates. Use Pandatech.MassTransit.EfCoreOutbox instead — a provider-agnostic replacement that works with any EF Core database provider, including SQLite. It adds database-backed inbox retry, lease theft detection, and full feature parity with the PostgreSQL package. Migration guide: replace the MassTransit.SQLiteOutbox namespace with MassTransit.EfCoreOutbox, add the LeasedUntil, Payload, Type, DestinationAddress, RetryCount, NextRetryAt, and LastError columns to your InboxMessages table (or recreate via EF Core migrations), and update your DbContext entity configuration to use the new package's ConfigureInboxOutboxEntities().",
    "reasons": [
      "Legacy"
    ]
  },
  "description": "Outbox and Inbox pattern implementation for MassTransit with SQLite and EF Core. Supports multiple DbContexts for modular monolith and microservice architectures. Uses a lease-based concurrency strategy compatible with SQLite's single-writer model. Wire-compatible with Pandatech.MassTransit.PostgresOutbox.",
