  "description": "Parses a file, arg, or stdin using a built-in or generated parser.\nThis program is part of the Trash toolkit.",
  "id": "trparse",
  "isPrerelease": false,
  "lastEdited": "2026-05-08T13:27:16.38Z",
  "listed": true,
  "packageHash": "b7ijKDGAXdzjZjFWOsS4nzwLWzvkFwWmIqUJofl8wqig5bgM6E/DFFlbaAMadbBFQ8BalunqiJHCRdkmh9a3XA==",
  "packageHashAlgorithm": "SHA512",
