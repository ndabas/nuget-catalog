  "description": "Send documents for e-signing with Assently API.\nThis client library allows you to easily integrate electronic signatures in your workflows and collect electronic signatures for web forms, documents or other data.\nMultiple methods for e-signing, such as Electronic ID, SMS and touch signatures are supported.\nSee https://app.assently.com/api/v2 for documentation",
  "iconFile": "icon.png",
  "id": "Assently.Client",
  "isPrerelease": false,
  "lastEdited": "2026-11-25T22:38:40.07Z",
